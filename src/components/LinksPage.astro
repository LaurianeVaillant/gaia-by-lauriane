---
import {site} from '../data/site';
import '@fontsource-variable/fraunces';
import '../styles/links-page.css';
import LightOnlyHead from './LightOnlyHead.astro';
import {socialImage} from '../data/social-images';
const preview=socialImage('fr','links');
const previewUrl=new URL(preview.path,site.origin).href;
const actions=[['Acupuncture traditionnelle','/fr/acupuncture/'],['Découvrir le site','/fr/']];
---
<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><LightOnlyHead/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>GAIA by Lauriane — Liens</title><meta name="description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><link rel="canonical" href={`${site.origin}/links/`}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content="GAIA by Lauriane — Liens"/><meta property="og:description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><meta property="og:url" content={`${site.origin}/links/`}/><meta property="og:image" content={previewUrl}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:type" content="image/jpeg"/><meta property="og:image:alt" content={preview.alt}/><meta property="og:locale" content="fr_FR"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="GAIA by Lauriane — Liens"/><meta name="twitter:description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><meta name="twitter:image" content={previewUrl}/><meta name="twitter:image:alt" content={preview.alt}/></head><body class="links-shell"><main class="links-poster"><header class="links-identity"><a class="links-wordmark" href="/fr/" aria-label="GAIA by Lauriane — voir le site">Gaia<span>by Lauriane</span></a><img src="/images/lauriane-links.webp" srcset="/images/lauriane-links-160.webp 160w, /images/lauriane-links-240.webp 240w, /images/lauriane-links-320.webp 320w, /images/lauriane-links-400.webp 400w" sizes="(max-width:480px) 110px, 124px" width="900" height="1172" alt="Lauriane souriante, marchant au bord de l’eau au coucher du soleil" fetchpriority="high"/></header><h1 class="links-positioning">Reconnexion · Acupuncture · Énergie · Féminin</h1><nav class="links-primary" aria-label="Rendez-vous et pratiques"><a class="links-book" href="/prendre-rendez-vous/">Prendre rendez-vous<span aria-hidden="true">↗</span></a>{actions.map(([label,href],i)=><a class={`links-practice tone-${i}`} href={href}>{label}<span aria-hidden="true">↗</span></a>)}</nav><footer class="links-contact"><p>GAIA by Lauriane</p></footer></main></body></html>
