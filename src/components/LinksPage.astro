---
import {booking} from '../data/booking';
import {site} from '../data/site';
import '@fontsource-variable/fraunces';
import '../styles/links-page.css';
const message='Bonjour Lauriane, je viens de votre Instagram et je souhaiterais avoir plus d’informations.';
const whatsapp=`https://wa.me/${booking.phone}?text=${encodeURIComponent(message)}`;
const practices=[['Acupuncture traditionnelle','/fr/acupuncture/'],['Aculift','/fr/aculift/'],['Pranic Healing','/fr/pranic-healing/'],['Santé féminine','/fr/sante-feminine/']];
---
<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>GAIA by Lauriane — Liens</title><meta name="description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><link rel="canonical" href={`${site.origin}/links/`}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#FFF4C7"/></head><body class="links-shell"><main class="links-poster"><header class="links-identity"><a class="links-wordmark" href="/fr/" aria-label="GAIA by Lauriane — voir le site">Gaia<span>by Lauriane</span></a><img src="/images/lauriane-links.webp" width="900" height="1066" alt="Lauriane souriante, marchant au bord de l’eau au coucher du soleil" fetchpriority="high"/></header><h1 class="links-positioning">Reconnexion · Acupuncture · Énergie · Féminin</h1><nav class="links-primary" aria-label="Rendez-vous et pratiques"><a class="links-book" href="/prendre-rendez-vous/">Prendre rendez-vous<span aria-hidden="true">↗</span></a>{practices.map(([label,href],i)=><a class={`links-practice tone-${i}`} href={href}>{label}<span aria-hidden="true">↗</span></a>)}</nav><nav class="links-secondary" aria-label="Découvrir GAIA"><a href="/fr/a-propos/">À propos<span aria-hidden="true">↗</span></a><a href="/fr/journal/">Journal<span aria-hidden="true">↗</span></a><a href="/fr/">Voir le site<span aria-hidden="true">↗</span></a></nav><footer class="links-contact"><a href={whatsapp}>Écrire sur WhatsApp<span aria-hidden="true">↗</span></a><p>GAIA by Lauriane</p></footer></main></body></html>
