<!doctype html><html lang="fr"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>GAIA by Lauriane — Liens</title><meta name="description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><link rel="canonical" href={`${site.origin}/links/`}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#FFF4C7"/><meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content="GAIA by Lauriane — Liens"/><meta property="og:description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><meta property="og:url" content={`${site.origin}/links/`}/><meta property="og:image" content={`${site.origin}/images/lauriane-links.webp`}/><meta property="og:image:alt" content="Lauriane souriante, marchant au bord de l’eau au coucher du soleil"/><meta property="og:locale" content="fr_FR"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="GAIA by Lauriane — Liens"/><meta name="twitter:description" content="Reconnexion · Acupuncture · Énergie · Féminin. Retrouvez les pratiques de Lauriane et prenez rendez-vous."/><meta name="twitter:image" content={`${site.origin}/images/lauriane-links.webp`}/><meta name="twitter:image:alt" content="Lauriane souriante, marchant au bord de l’eau au coucher du soleil"/></head><body class="links-shell"><main class="links-poster"><header class="links-identity"><a class="links-wordmark" href="/fr/" aria-label="GAIA by Lauriane — voir le site">Gaia<span>by Lauriane</span></a><img src="/images/lauriane-links.webp" width="900" height="1175" alt="Lauriane souriante, marchant au bord de l’eau au coucher du soleil" fetchpriority="high"/></header><h1 class="links-positioning">Reconnexion · Acupuncture · Énergie · Féminin</h1><nav class="links-primary" aria-label="Rendez-vous et pratiques"><a class="links-book" href="/prendre-rendez-vous/">Prendre rendez-vous<span aria-hidden="true">↗</span></a>{actions.map(([label,href],i)=><a class={`links-practice tone-${i}`} href={href}>{label}<span aria-hidden="true">↗</span></a>)}</nav><footer class="links-contact"><p>GAIA by Lauriane</p></footer></main></body></html>
