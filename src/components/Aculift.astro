---
import Photo from './Photo.astro';
import {aculiftFr as c} from '../data/aculift-fr';
import {url} from '../data/site';
---
<div class="aculift-page">
<section class="section aculift-hero"><div><h1>{c.title}</h1><p class="aculift-subtitle">{c.subtitle}</p><p>{c.intro}</p><a class="button" href={url('fr','contact')}>Prendre rendez-vous</a></div><div class="aculift-photo"><Photo name="about-portrait" hero width={1024} height={1536} alt="Portrait rapproché de Lauriane dans une lumière naturelle dorée, une main près du visage"/></div></section>
<section class="section aculift-definition"><div class="aculift-editorial"><h2 class="eyebrow">Qu’est-ce que l’Aculift ?</h2><div>{c.definition.map(p=><p>{p}</p>)}<a class="text-link" href={url('fr','acupuncture')}>Découvrir l’acupuncture traditionnelle</a></div></div></section>
<section class="section aculift-reasons"><h2 class="eyebrow">Pourquoi venir ?</h2><ul class="aculift-topic-grid">{c.reasons.map(reason=><li>{reason}</li>)}</ul></section>
<section class="section aculift-session"><h2 class="eyebrow">Comment se déroule une séance ?</h2><div class="aculift-step-grid">{c.steps.map(step=><div><h3>{step.title}</h3><p>{step.copy}</p></div>)}</div></section>
<section class="section aculift-personal"><div class="aculift-editorial"><h2 class="eyebrow">Une approche personnalisée</h2><div>{c.personal.map(p=><p>{p}</p>)}<a class="text-link" href={url('fr','about')}>Découvrir mon parcours</a></div></div></section>
<section class="section aculift-evolving"><div class="aculift-editorial"><h2 class="eyebrow">Une pratique en évolution</h2><div>{c.evolving.map(p=><p>{p}</p>)}</div></div></section>
<section class="final-cta section"><h2>RECONNECT.</h2><p class="aculift-final-support">Se reconnecter à ce qui a toujours été là.</p><a class="button" href={url('fr','contact')}>Prendre rendez-vous</a></section>
</div>
