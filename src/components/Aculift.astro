---
import '../styles/aculift-system.css';
import Photo from './Photo.astro';
import SoftBoundary from './SoftBoundary.astro';
import {aculiftFr as c} from '../data/aculift-fr';
import {url} from '../data/site';
---
<div class="aculift-page">
  <section class="section aculift-hero">
    <div class="aculift-hero-copy"><h1>{c.title}</h1><p class="aculift-subtitle">{c.subtitle}</p><p class="aculift-intro">{c.intro}</p><p class="aculift-factual">{c.factual}</p><a class="button" href="/prendre-rendez-vous/">Prendre rendez-vous</a></div>
    <div class="aculift-photo"><Photo name="about-portrait" hero sizes="(max-width:480px) calc(100vw - 40px), (max-width:800px) calc(100vw - 48px), 50vw" width={1024} height={1536} alt="Portrait rapproché de Lauriane dans une lumière naturelle dorée, une main près du visage"/></div>
  </section>
  <section class="section aculift-definition">
    <div class="aculift-editorial"><h2>Qu’est-ce que l’Aculift ?</h2><div class="aculift-definition-copy">{c.definition.map(p=><p>{p}</p>)}<a class="text-link" href={url('fr','acupuncture')}>Découvrir l’acupuncture traditionnelle</a></div></div>
  </section>
  <SoftBoundary from="var(--white)" to="var(--aculift-pink)" intensity="calm"/>
  <section class="section aculift-reasons">
    <h2>Pourquoi venir ?</h2><p class="aculift-reasons-intro">{c.reasonsIntro}</p><ul class="aculift-topic-grid">{c.reasons.map(reason=><li>{reason}</li>)}</ul>
  </section>
  <SoftBoundary from="var(--aculift-pink)" to="var(--butter)" intensity="network-out"/>
  <section class="section aculift-personal">
    <div class="aculift-personal-copy"><h2>Une approche personnalisée</h2>{c.personal.map(p=><p>{p}</p>)}</div>
    <div class="aculift-face" aria-hidden="true"><img src="/images/aculift-face.webp" alt="" width="1024" height="1024" loading="lazy" decoding="async"/></div>
  </section>
  <section class="section aculift-session">
    <h2>Comment se déroule <span class="keep-together">une séance ?</span></h2><div class="aculift-step-grid"><svg class="aculift-session-contour" viewBox="0 0 160 64" fill="none" aria-hidden="true"><path d="M4 46C29 45 25 12 59 13C80 14 83 42 110 40C128 39 140 30 156 26" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="88" cy="31" r="3" fill="var(--orange)"/></svg>{c.steps.map(step=><div><h3>{step.title}</h3><p>{step.copy}</p></div>)}</div>
  </section>
  <section class="section aculift-closing">
    <h2>Prendre <span class="keep-together cta-word">rendez-vous</span><span>.</span></h2><p>{c.closing}</p><a class="button" href="/prendre-rendez-vous/">Prendre rendez-vous</a>
  </section>
</div>
