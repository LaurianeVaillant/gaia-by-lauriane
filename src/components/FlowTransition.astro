---
interface Props {id:string;text:string;decorative?:boolean;class?:string;to?:string;variant?:'default'|'calm';}
const {id,text,decorative=true,class:className='',to='var(--white)',variant='default'}=Astro.props;
const desktopPath=variant==='calm'?'M-30 72C260 84 445 30 760 46C1070 62 1260 79 1470 62':'M-30 82C260 120 385 8 685 58S1130 127 1470 50';
const mobilePath=variant==='calm'?'M-15 62C75 73 133 29 230 43C321 56 380 67 435 53':'M-15 62C119 85 224 20 435 56';
---
<div class:list={['gaia-flow',className]} aria-hidden={decorative?'true':undefined}>{!decorative&&<p class="sr-only">{text}</p>}<svg class="flow-desktop" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><defs><path id={id} d={desktopPath}/></defs><path d={`${desktopPath}V132H-30Z`} fill={to}/><use href={`#${id}`} fill="none" stroke="var(--violet)" stroke-width="1.2"/>{variant!=='calm'&&<path d="M-30 87C260 123 385 14 685 64S1130 133 1470 55" fill="none" stroke="var(--orange)" stroke-width=".6" opacity=".65"/>}<text fill="var(--violet)" dy="-7"><textPath href={`#${id}`} startOffset={className==='hero-flow'?'59%':'38%'}>{text}</textPath></text></svg><svg class="flow-mobile" viewBox="0 0 420 108" preserveAspectRatio="none" aria-hidden="true"><defs><path id={`${id}-mobile`} d={mobilePath}/></defs><path d={`${mobilePath}V110H-15Z`} fill={to}/><use href={`#${id}-mobile`} fill="none" stroke="var(--violet)" stroke-width="1"/>{variant!=='calm'&&<path d="M-15 67C119 90 224 25 435 61" fill="none" stroke="var(--orange)" stroke-width=".5" opacity=".65"/>}<text fill="var(--violet)" dy="-7"><textPath href={`#${id}-mobile`} startOffset={className==='hero-flow'?'27%':'12%'}>{text}</textPath></text></svg></div>
