---
interface Props {id:string;text:string;decorative?:boolean;class?:string;}
const {id,text,decorative=true,class:className=''}=Astro.props;
---
<div class:list={['gaia-flow',className]} aria-hidden={decorative?'true':undefined}>{!decorative&&<p class="sr-only">{text}</p>}<svg class="flow-desktop" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><defs><path id={id} d="M-30 82C260 120 385 8 685 58S1130 127 1470 50"/></defs><path d="M-30 82C260 120 385 8 685 58S1130 127 1470 50V132H-30Z" fill="var(--white)"/><use href={`#${id}`} fill="none" stroke="var(--violet)" stroke-width="1.2"/><path d="M-30 87C260 123 385 14 685 64S1130 133 1470 55" fill="none" stroke="var(--orange)" stroke-width=".6" opacity=".65"/><text fill="var(--violet)" dy="-7"><textPath href={`#${id}`} startOffset={className==='hero-flow'?'59%':'38%'}>{text}</textPath></text></svg><svg class="flow-mobile" viewBox="0 0 420 108" preserveAspectRatio="none" aria-hidden="true"><defs><path id={`${id}-mobile`} d="M-15 58C92 86 135 25 231 51S330 84 435 48"/></defs><path d="M-15 58C92 86 135 25 231 51S330 84 435 48V110H-15Z" fill="var(--white)"/><use href={`#${id}-mobile`} fill="none" stroke="var(--violet)" stroke-width="1"/><path d="M-15 63C92 91 135 30 231 56S330 89 435 53" fill="none" stroke="var(--orange)" stroke-width=".5" opacity=".65"/><text fill="var(--violet)" dy="-7"><textPath href={`#${id}-mobile`} startOffset={className==='hero-flow'?'35%':'14%'}>{text}</textPath></text></svg></div>
