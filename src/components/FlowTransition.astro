---
interface Props {id:string;text:string;decorative?:boolean;class?:string;to?:string;variant?:'default'|'calm';}
const {id,text,decorative=true,class:className='',to='var(--white)',variant='default'}=Astro.props;
const desktopPath=variant==='calm'?'M-30 70C370 36 780 112 1470 58':'M-30 82C260 120 385 8 685 58S1130 127 1470 50';
const mobilePath=variant==='calm'?'M-15 54C105 34 245 78 435 48':'M-15 58C92 86 135 25 231 51S330 84 435 48';
---
<div class:list={['gaia-flow',className]} aria-hidden={decorative?'true':undefined}>{!decorative&&<p class="sr-only">{text}</p>}<svg class="flow-desktop" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true"><defs><path id={id} d={desktopPath}/></defs><path d={`${desktopPath}V132H-30Z`} fill={to}/><use href={`#${id}`} fill="none" stroke="var(--violet)" stroke-width="1.2"/>{variant!=='calm'&&<path d="M-30 87C260 123 385 14 685 64S1130 133 1470 55" fill="none" stroke="var(--orange)" stroke-width=".6" opacity=".65"/>}<text fill="var(--violet)" dy="-7"><textPath href={`#${id}`} startOffset={className==='hero-flow'?'59%':'38%'}>{text}</textPath></text></svg><svg class="flow-mobile" viewBox="0 0 420 108" preserveAspectRatio="none" aria-hidden="true"><defs><path id={`${id}-mobile`} d={mobilePath}/></defs><path d={`${mobilePath}V110H-15Z`} fill={to}/><use href={`#${id}-mobile`} fill="none" stroke="var(--violet)" stroke-width="1"/>{variant!=='calm'&&<path d="M-15 63C92 91 135 30 231 56S330 89 435 53" fill="none" stroke="var(--orange)" stroke-width=".5" opacity=".65"/>}<text fill="var(--violet)" dy="-7"><textPath href={`#${id}-mobile`} startOffset={className==='hero-flow'?'35%':'14%'}>{text}</textPath></text></svg></div>
