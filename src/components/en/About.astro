---
import AboutPhoto from '../AboutPhoto.astro';
import '../../styles/about-system.css';
import {aboutEn as c} from '../../data/about-en';
import {url} from '../../data/site';
const [origin,encounters,therapist,gaia]=c.chapters;
const external={target:'_blank',rel:'noopener noreferrer'};
---
<div class="about-journal">
<section class="aj-section aj-hero" aria-labelledby="about-title">
<div class="aj-hero-copy"><p class="aj-label">ABOUT</p><div class="aj-name"><h1 id="about-title">Lauriane</h1><svg viewBox="0 0 310 18" fill="none" aria-hidden="true"><path d="M4 12C78 5 180 9 304 5M30 16C110 11 204 14 270 10" stroke="#FF6230" stroke-width="2.5" stroke-linecap="round"/></svg></div><p class="aj-profession">Traditional Acupuncture Practitioner</p><p class="aj-hero-quote">A path guided by curiosity, intuition and the people I’ve met.</p><p class="aj-geography">Paris · Val-d’Oise · Goa</p></div>
<AboutPhoto slotName="ABOUT_HERO" name="journal-hero" hero width={1080} height={1076} alt="Lauriane smiling, sitting outdoors surrounded by greenery" class="aj-portrait"/>
</section>
<section class="aj-section aj-origin" aria-labelledby="about-origin">
<div class="aj-origin-copy"><h2 id="about-origin">{origin[0]}</h2>{origin.slice(1).map(p=><p>{p.includes("the much-loved witch")?<>{p.split("the much-loved witch")[0]}<strong class="aj-cheeky">the much-loved witch</strong>{p.split("the much-loved witch")[1]}</>:p}</p>)}</div>
<AboutPhoto slotName="ABOUT_TRAVEL_01" name="journal-travel" width={1080} height={1338} alt="Lauriane seen from behind on a pebbled riverbank in India, facing the river and hills" caption="Rishikesh, the world capital of yoga, India" class="aj-travel"/>
</section>
<section class="aj-section aj-encounters" aria-labelledby="about-encounters">
<div class="aj-encounters-layout"><div class="aj-archive"><AboutPhoto slotName="ABOUT_INDIA_01" name="journal-india" width={1080} height={2340} alt="A ceremony on the banks of the Ganges in India, facing the river and mountains" caption="On the banks of the Ganges during a Hindu Aarti ceremony, India" class="aj-ceremony"/><AboutPhoto slotName="ABOUT_INDIA_02" name="journal-yoga" width={960} height={1280} alt="Lauriane practising a yoga pose with a strap, guided by a teacher in India" caption="India · Daily practice" class="aj-small-archive"/></div><div class="aj-encounters-copy"><div class="aj-encounters-heading"><p class="aj-label">THE PATH</p><h2 id="about-encounters">Intuition, encounters…<br class="aj-encounters-break"/> and “coincidences”</h2></div>{encounters.map(p=><p>{p}</p>)}</div></div>
</section>
<section class="aj-statement" aria-label="What connects the disciplines"><p>Nothing works<br/> in silos<span>.</span></p><p class="aj-statement-support">Body. Energy. Emotions. Environment.</p></section>
<section class="aj-section aj-therapist" aria-labelledby="about-therapist"><div class="aj-therapist-layout"><div class="aj-therapist-copy"><div class="aj-therapist-heading"><p class="aj-label">IN MY PRACTICE</p><h2 id="about-therapist">The practitioner<br/> I’m working towards being</h2></div>{therapist.map((p,i)=><p class:list={{'aj-intimate':i===0,'aj-emphasis':i===4||i===5}}>{i===4?<><strong class="aj-listening">Listening. Really listening.</strong>{p.slice('Listening. Really listening.'.length)}</>:p}</p>)}</div><AboutPhoto slotName="ABOUT_PRACTICE_01" name="journal-practice" width={1536} height={2048} alt="Lauriane practising, her hands on the back of a person lying down in a care centre in Nepal" caption="During an acupuncture mission in Poha, Nepal" class="aj-practice"/></div></section>
<section class="aj-section aj-training" aria-labelledby="about-training"><h2 id="about-training" class="aj-label">A FEW STEPS ALONG THE WAY</h2><div class="aj-training-layout"><div class="aj-training-index">
<div class="aj-training-item"><h3>TRADITIONAL ACUPUNCTURE</h3><div><p>3 years of training at Centre Imhotep, Paris</p><a {...external} href="https://centre-imhotep.com/">Centre Imhotep <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div>
<div class="aj-training-item"><h3>PRANIC HEALING</h3><div><p>Trained in Kathmandu, Nepal</p><ul><li>Basic Pranic Healing</li><li>Advanced Pranic Healing</li><li>Pranic Psychotherapy</li><li>Achieving Oneness with the Higher Soul</li></ul><p>Following the teachings of Master Choa Kok Sui</p><a {...external} href="https://pranichealingnepal.com/">Pranic Healing Nepal <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div>
<div class="aj-training-item"><h3>YOGA</h3><div><p>200H TTC<br/>“Love and All Is Coming”<br/>School by Talia Sutra</p><a {...external} href="https://laaictrainings.com/">Love and All Is Coming <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a></div></div>
<div class="aj-training-item"><h3>COMPLEMENTARY APPROACHES</h3><div><p>Japanese acupuncture, training in the body and movement…</p></div></div>
</div><AboutPhoto slotName="ABOUT_TRAINING_01" name="journal-training" width={1200} height={1600} alt="Lauriane studying singing bowls, sitting in front of bowls and a gong" class="aj-study"/></div></section>
<section class="aj-section aj-gaia" aria-labelledby="about-gaia"><div class="aj-gaia-heading"><h2 id="about-gaia">Why GAIA?</h2><div class="aj-gaia-wordmark" aria-hidden="true">Gaia</div></div><div class="aj-gaia-copy">{gaia.map((p,i)=><p class:list={{'aj-gaia-lead':i===0,'aj-gaia-power':i===3,'aj-gaia-closing':i===gaia.length-1}}>{p}</p>)}</div></section>
<section class="aj-section aj-ending" aria-labelledby="about-ending"><AboutPhoto slotName="ABOUT_NOW_01" name="about-yoga" width={1448} height={1086} alt="Lauriane in a yoga pose on the beach, facing the sea at sunset" caption="The movement continues." class="aj-now"/><div class="aj-ending-copy"><h2 id="about-ending">Explore<br/> my approach<span>.</span></h2><ul class="aj-service-links"><li><a href={url('en','acupuncture')}>Acupuncture <span aria-hidden="true">↗</span></a></li><li><a href={url('en','aculift')}>Aculift <span aria-hidden="true">↗</span></a></li><li><a href={url('en','pranic')}>Pranic Healing <span aria-hidden="true">↗</span></a></li><li><a href={url('en','women')}>Women’s Health <span aria-hidden="true">↗</span></a></li></ul><a class="button" href="/en/book-an-appointment/">Book an appointment</a></div></section>
</div>
