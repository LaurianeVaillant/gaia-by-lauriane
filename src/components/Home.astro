---
import Photo from './Photo.astro';
import {url,labels,type Lang,type Page} from '../data/site';
import {home} from '../data/home';
const {lang} = Astro.props as {lang:Lang}; const fr=lang==='fr'; const t=labels[lang]; const c=home[lang];
---
<section class="hero"><div class="hero-copy"><div class="wordmark">Gaia</div><p class="byline">by Lauriane</p><h1>{fr?<>Se <em>reconnecter</em><br/>à ce qui a toujours<br/>été là.</>:<><em>Reconnect</em> with<br/>what has always<br/>been there.</>}</h1><div class="hero-details"><p>{c.profession}</p><p>Acupuncture · Aculift · Pranic Healing</p></div><a class="button" href={url(lang,'contact')}>{t.book}</a></div><div class="hero-photo"><Photo name="portrait" hero alt={fr?'Lauriane, les yeux fermés, dans la lumière dorée au bord de la mer':'Lauriane with her eyes closed in golden light by the sea'}/></div></section>
<section class="manifesto section"><h2 class="eyebrow">Nothing works in silos</h2><div class="manifesto-copy"><p>{c.manifesto[0]}</p><p class="separated">{c.manifesto[1]}</p></div></section>
<section class="network section"><h2 class="eyebrow">Your body is a network</h2><div class="split"><div><p>{c.acupuncture}</p><a class="text-link" href={url(lang,'acupuncture')}>{t.discover}</a></div><div class="map" role="img" aria-label={fr?'Quelques lignes et points de connexion illustrant un réseau':'A few lines and connection points illustrating a network'}><svg viewBox="0 0 500 400" aria-hidden="true"><path d="M35 300C130 290 165 80 440 95" stroke="#6C32FF"/><path d="M60 75C235 90 215 300 465 315" stroke="#FF5A1F"/><path d="M115 370C180 250 345 210 365 30" stroke="#6C32FF"/>{[[205,159],[235,254],[322,164]].map(([cx,cy])=><circle cx={cx} cy={cy} r="4"/>)}</svg></div></div></section>
<section class="practices section"><h2 class="eyebrow">{c.practicesLabel}</h2><div class="practice-grid">{c.practices.map(p=><article class="practice"><h3>{p.title}</h3><p>{p.description}</p><a class="text-link" href={url(lang,p.key as Page)}>{c.discover}<span class="sr-only"> — {p.title}</span></a></article>)}</div></section>
<section class="women section"><div class="women-photo"><Photo name="hands" alt={fr?'Détail des mains de Lauriane jointes, ornées de bagues et d’un bracelet coloré':'Detail of Lauriane’s joined hands with rings and a colourful bracelet'}/></div><div><h2 class="eyebrow">{c.womenLabel}</h2>{c.women.map(p=><p>{p}</p>)}<a class="text-link" href={url(lang,'women')}>{c.womenCta}</a></div></section>
<section class="about section"><h2 class="eyebrow">I was looking for a way to connect the dots</h2><div class="split"><div>{c.story.map(p=><p>{p}</p>)}<p class="story-statement serif">Nothing works in silos.</p><a class="text-link" href={url(lang,'about')}>{c.storyCta}</a></div><div class="editorial-collage"><Photo name="movement" alt={fr?'Lauriane dans une posture de yoga sur une plage':'Lauriane practising yoga on a beach'}/><Photo name="softness" alt={fr?'Lauriane au coucher du soleil, les mains près du visage':'Lauriane at sunset with her hands near her face'}/></div></div></section>
<section class="power section"><div><h2 class="eyebrow">Power & Softness</h2>{c.power.map(p=><p>{p}</p>)}</div><img class="gaia-symbol" src="/images/gaia-symbol.png" width="460" height="542" loading="lazy" decoding="async" alt={fr?'Symbole GAIA : un soleil et une lune entrelacés':'GAIA symbol: an intertwined sun and moon'}/></section>
<section class="project section"><h2 class="eyebrow">The GAIA Project</h2><p>{c.project}</p><p class="project-statement serif">GAIA creates spaces for reconnection.</p></section>
<section class="locations section"><h2 class="eyebrow">{c.locationsLabel}</h2><p class="locations-title">Paris <span>·</span> Val-d’Oise <span>·</span> Goa</p><p>{c.locations}</p><a class="text-link" href={url(lang,'contact')}>{c.locationsCta}</a></section>
<section class="final-cta section"><h2>RECONNECT.</h2><p class="serif">{c.closing}</p><a class="button" href={url(lang,'contact')}>{t.book}</a></section>
