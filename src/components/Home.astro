---
import Photo from './Photo.astro';
import TextEmphasis from './TextEmphasis.astro';
import {homeEmphasis} from '../data/home-emphasis';
import GaiaMark from './GaiaMark.astro';
import FlowTransition from './FlowTransition.astro';
import SoftBoundary from './SoftBoundary.astro';
import PracticePictogram from './PracticePictogram.astro';
import PhotoMask from './PhotoMask.astro';
import '../styles/home-art.css';
import '../styles/home-system.css';
import '../styles/home-typography.css';
import '../styles/home-chapters.css';
import '../styles/home-desktop.css';
import '../styles/home-responsive.css';
import HomeNetwork from './HomeNetwork.astro';
import {url,labels,type Lang,type Page} from '../data/site';
import {home} from '../data/home';
const {lang} = Astro.props as {lang:Lang}; const fr=lang==='fr'; const t=labels[lang]; const c=home[lang]; const emphasis=homeEmphasis[lang]; const womenWord=fr?'féminité':'womanhood'; const womenParts=c.womenLabel.split(womenWord);
---
<div class="gaia-home" data-hero-photo="fade" style={`--hero-mask:url(#hero-organic-${lang});--women-mask:url(#women-organic-${lang})`}>
<svg class="gaia-mask-definitions" width="0" height="0" aria-hidden="true"><defs>
<clipPath id={`hero-organic-${lang}`} clipPathUnits="objectBoundingBox"><path d="M.03 .34C-.02 .23 .1 .2 .2 .12C.34 -.02 .46 -.01 .61 .07C.75 .15 .84 -.02 .94 .03C1.05 .08 .94 .27 .94 .39C.94 .52 1.03 .64 .97 .82C.93 .99 .76 1.04 .62 .96C.47 .87 .34 1.04 .18 .97C.03 .92 .07 .77 .11 .62C.16 .48 .06 .43 .03 .34Z"/></clipPath>
<clipPath id={`women-organic-${lang}`} clipPathUnits="objectBoundingBox"><path d="M.05 .23C.14 .07 .32 .13 .43 .04C.58 -.04 .76 .08 .79 .2C.82 .31 1.02 .31 .99 .48C.97 .62 .89 .65 .92 .77C.95 .96 .75 .97 .62 1C.45 1.02 .34 .91 .18 .91C.04 .91 .02 .76 .09 .64C.14 .54 -.04 .4 .05 .23Z"/></clipPath>
</defs></svg>
<section class="hero"><div class="hero-copy"><div class="wordmark">Gaia</div><p class="byline">by Lauriane</p><p class="hero-statement">{fr?<>Se <em><GaiaMark>reconnecter</GaiaMark></em><br/>à ce qui a toujours<br/>été là.</>:<><em><GaiaMark>Reconnect</GaiaMark></em> with<br/>what has always<br/>been there.</>}</p><div class="hero-details"><h1>{c.profession}</h1><p>Acupuncture · Aculift · Pranic Healing</p></div><a class="button" href={fr?'/prendre-rendez-vous/':'/en/book-an-appointment/'}>{t.book}</a></div><div class="hero-photo"><Photo name="portrait" hero sizes="(max-width: 900px) 100vw, 52vw" alt={fr?'Lauriane, les yeux fermés, dans la lumière dorée au bord de la mer':'Lauriane with her eyes closed in golden light by the sea'}/></div></section>
<FlowTransition id={`hero-flow-${lang}`} text="NOTHING WORKS IN SILOS" class="hero-flow"/>
<section class="manifesto section"><div class="manifesto-copy"><p>{fr?c.manifesto[0].split(/(?<=parties indépendantes\.)|(?<=Tout s’influence\.)/).map((part,i)=><>{i>0&&<br/>}<TextEmphasis text={part} phrases={emphasis.manifesto}/></>):<TextEmphasis text={c.manifesto[0]} phrases={emphasis.manifesto}/>}</p><p class="separated">{c.manifesto[1]}</p></div><h2 class="eyebrow"><GaiaMark>Nothing works</GaiaMark><br/> in silos.</h2></section>
<SoftBoundary from="var(--white)" to="var(--chapter-lavender)" intensity="network-in"/>
<section class="network section"><div class="network-copy"><h2 class="eyebrow network-title"><GaiaMark>Your system</GaiaMark><br/> is a network.</h2>{(Array.isArray(c.acupuncture)?c.acupuncture:[c.acupuncture]).map(p=><p>{p}</p>)}<a class="text-link" href={url(lang,'acupuncture')}>{t.discover}</a></div><HomeNetwork lang={lang}/></section>
<SoftBoundary from="var(--chapter-lavender)" to="var(--chapter-cream)" intensity="network-out"/>
<section class="practices section"><h2 class="eyebrow">{c.practicesLabel}</h2><div class="practice-grid">{c.practices.map(p=><article class="practice"><div class="practice-heading"><PracticePictogram kind={p.key}/><h3>{p.title}</h3></div><p>{p.description}</p><a class="text-link" href={url(lang,p.key as Page)}>{c.discover}<span class="sr-only"> — {p.title}</span></a></article>)}</div></section>
<SoftBoundary from="var(--chapter-cream)" to="var(--chapter-pink)" class="practice-boundary"/>
<section class="women section"><PhotoMask class="women-photo"><Photo name="hands" sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 900px) 520px, (max-width: 1100px) calc((100vw - 144px) / 2), (max-width: 1440px) calc((100vw - 16vw) / 2), 592px" alt={fr?'Détail des mains de Lauriane jointes, ornées de bagues et d’un bracelet coloré':'Detail of Lauriane’s joined hands with rings and a colourful bracelet'}/></PhotoMask><div><h2 class="eyebrow women-title">{womenParts[0]}<span class="violet"><GaiaMark>{womenWord}</GaiaMark></span>{womenParts[1]}</h2>{c.women.map(p=><p><TextEmphasis text={p} phrases={emphasis.women}/></p>)}<a class="text-link" href={url(lang,'women')}>{c.womenCta}</a></div></section>
<SoftBoundary from="var(--chapter-pink)" to="var(--chapter-cream)" reverse/>
<section class="about section"><div class="story-module"><h2 class="eyebrow">I WAS LOOKING FOR A WAY TO CONNECT THE DOTS.</h2><div class="split"><div>{c.story.map(p=><p><TextEmphasis text={p} phrases={emphasis.story}/></p>)}{<p class="story-statement">Nothing works in silos.</p>}<a class="text-link" href={url(lang,'about')}>{c.storyCta}</a></div><div class="editorial-collage"><Photo name="movement" sizes="(max-width: 700px) calc(100vw - 48px), (max-width: 900px) 640px, (max-width: 1100px) calc((100vw - 144px) / 2), (max-width: 1440px) calc((100vw - 16vw) / 2), 592px" alt={fr?'Lauriane dans une posture de yoga sur une plage':'Lauriane practising yoga on a beach'}/></div></div></div></section>
<SoftBoundary from="var(--chapter-cream)" to="var(--chapter-peach)" intensity="calm"/>
<section class="power section"><div><h2 class="eyebrow">Power & Softness</h2>{c.power.map((p,i)=><><p>{p}</p>{i===0&&<div class="power-pairs"><p>YIN / YANG</p><p>SHIVA / SHAKTI</p><p>HA / THA</p><p>{fr?'SOLEIL / LUNE':'SUN / MOON'}</p></div>}</>)}</div><div class="power-dialogue"><img class="gaia-symbol" src="/images/gaia-symbol.png" width="460" height="542" loading="lazy" decoding="async" alt={fr?'Symbole GAIA : un soleil et une lune entrelacés':'GAIA symbol: an intertwined sun and moon'}/></div></section>
<SoftBoundary from="var(--chapter-peach)" to="var(--chapter-cream)" reverse/>
<section class="project section"><h2 class="eyebrow project-display-title">The <span>GAIA</span> Project</h2><div class="project-copy">{(Array.isArray(c.project)?c.project:[c.project]).map(p=><p>{p}</p>)}</div></section>
<FlowTransition id={`project-flow-${lang}`} text="GAIA creates spaces for reconnection." decorative={false} to="var(--locations-white)" variant="calm" class="project-flow"/>
<section class="locations section"><h2 class="eyebrow">{c.locationsLabel}</h2><p class="locations-title">Paris <span>·</span> Val-d’Oise <span>·</span> Goa</p><p>{c.locations}</p><a class="text-link" href={fr?'/prendre-rendez-vous/':'/en/book-an-appointment/'}>{c.locationsCta}</a></section>
<SoftBoundary from="var(--locations-white)" to="var(--chapter-violet)" intensity="strong"/>
<section class="final-cta section"><h2>RECONNECT<span class="closing-dot">.</span></h2><div class="closing-actions"><a class="button" href={fr?'/prendre-rendez-vous/':'/en/book-an-appointment/'}>{t.book}</a><p class="serif">{c.closing}</p></div></section>

<SoftBoundary from="var(--chapter-violet)" to="var(--chapter-cream)" intensity="calm"/>
</div>

<script is:inline>
const gaiaPhotoOption = new URLSearchParams(window.location.search).get('hero');
if (gaiaPhotoOption === 'organic') document.querySelector('.gaia-home').dataset.heroPhoto = 'organic';
const gaiaMenu = document.querySelector('.mobile-nav');
gaiaMenu?.addEventListener('keydown', event => {
  if (event.key === 'Escape' && gaiaMenu.open) {
    gaiaMenu.open = false;
    gaiaMenu.querySelector('summary').focus();
  }
});
</script>
