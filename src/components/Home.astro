---
import Photo from './Photo.astro';
import GaiaMark from './GaiaMark.astro';
import FlowTransition from './FlowTransition.astro';
import OrganicBoundary from './OrganicBoundary.astro';
import PracticePictogram from './PracticePictogram.astro';
import PhotoMask from './PhotoMask.astro';
import '../styles/home-art.css';
import HomeNetwork from './HomeNetwork.astro';
import {url,labels,type Lang,type Page} from '../data/site';
import {home} from '../data/home';
const {lang} = Astro.props as {lang:Lang}; const fr=lang==='fr'; const t=labels[lang]; const c=home[lang]; const womenWord=fr?'féminité':'womanhood'; const womenParts=c.womenLabel.split(womenWord);
---
<div class="gaia-home" data-hero-photo="fade" style={`--hero-mask:url(#hero-organic-${lang});--women-mask:url(#women-organic-${lang})`}>
<svg class="gaia-mask-definitions" width="0" height="0" aria-hidden="true"><defs>
<clipPath id={`hero-organic-${lang}`} clipPathUnits="objectBoundingBox"><path d="M.03 .34C-.02 .23 .1 .2 .2 .12C.34 -.02 .46 -.01 .61 .07C.75 .15 .84 -.02 .94 .03C1.05 .08 .94 .27 .94 .39C.94 .52 1.03 .64 .97 .82C.93 .99 .76 1.04 .62 .96C.47 .87 .34 1.04 .18 .97C.03 .92 .07 .77 .11 .62C.16 .48 .06 .43 .03 .34Z"/></clipPath>
<clipPath id={`women-organic-${lang}`} clipPathUnits="objectBoundingBox"><path d="M.05 .23C.14 .07 .32 .13 .43 .04C.58 -.04 .76 .08 .79 .2C.82 .31 1.02 .31 .99 .48C.97 .62 .89 .65 .92 .77C.95 .96 .75 .97 .62 1C.45 1.02 .34 .91 .18 .91C.04 .91 .02 .76 .09 .64C.14 .54 -.04 .4 .05 .23Z"/></clipPath>
</defs></svg>
<section class="hero"><div class="hero-copy"><div class="wordmark">Gaia</div><p class="byline">by Lauriane</p><h1>{fr?<>Se <em><GaiaMark>reconnecter</GaiaMark></em><br/>à ce qui a toujours<br/>été là.</>:<><em><GaiaMark>Reconnect</GaiaMark></em> with<br/>what has always<br/>been there.</>}</h1><div class="hero-details"><p>{c.profession}</p><p>Acupuncture · Aculift · Pranic Healing</p></div><a class="button" href={url(lang,'contact')}>{t.book}</a></div><div class="hero-photo"><Photo name="portrait" hero alt={fr?'Lauriane, les yeux fermés, dans la lumière dorée au bord de la mer':'Lauriane with her eyes closed in golden light by the sea'}/></div></section>
<FlowTransition id={`hero-flow-${lang}`} text="NOTHING WORKS IN SILOS" class="hero-flow"/>
<section class="manifesto section"><h2 class="eyebrow"><GaiaMark>Nothing works in silos</GaiaMark></h2><div class="manifesto-copy"><p>{c.manifesto[0]}</p><p class="separated">{c.manifesto[1]}</p></div></section>
<section class="network section"><div class="network-copy"><h2 class="eyebrow network-title"><GaiaMark>Your body</GaiaMark><br/>is a network</h2><p>{c.acupuncture}</p><a class="text-link" href={url(lang,'acupuncture')}>{t.discover}</a></div><HomeNetwork lang={lang}/></section>
<OrganicBoundary/>
<section class="practices section"><h2 class="eyebrow">{c.practicesLabel}</h2><div class="practice-grid">{c.practices.map(p=><article class="practice"><PracticePictogram kind={p.key}/><h3>{p.title}</h3><p>{p.description}</p><a class="text-link" href={url(lang,p.key as Page)}>{c.discover}<span class="sr-only"> — {p.title}</span></a></article>)}</div></section>
<section class="women section"><PhotoMask class="women-photo"><Photo name="hands" alt={fr?'Détail des mains de Lauriane jointes, ornées de bagues et d’un bracelet coloré':'Detail of Lauriane’s joined hands with rings and a colourful bracelet'}/></PhotoMask><div><h2 class="eyebrow women-title">{womenParts[0]}<span class="violet"><GaiaMark>{womenWord}</GaiaMark></span>{womenParts[1]}</h2>{c.women.map(p=><p>{p}</p>)}<a class="text-link" href={url(lang,'women')}>{c.womenCta}</a></div></section>
<section class="about section"><h2 class="eyebrow">I was looking for a way to connect the dots.</h2><div class="split"><div>{c.story.map(p=><p>{p}</p>)}<p class="story-statement serif">Nothing works in silos.</p><a class="text-link" href={url(lang,'about')}>{c.storyCta}</a></div><div class="editorial-collage"><Photo name="movement" alt={fr?'Lauriane dans une posture de yoga sur une plage':'Lauriane practising yoga on a beach'}/></div></div></section>
<section class="power section"><div><h2 class="eyebrow">Power & Softness</h2>{c.power.map(p=><p>{p}</p>)}</div><img class="gaia-symbol" src="/images/gaia-symbol.png" width="460" height="542" loading="lazy" decoding="async" alt={fr?'Symbole GAIA : un soleil et une lune entrelacés':'GAIA symbol: an intertwined sun and moon'}/></section>
<section class="project section"><h2 class="eyebrow">The GAIA Project</h2><p>{c.project}</p></section>
<FlowTransition id={`project-flow-${lang}`} text="GAIA creates spaces for reconnection." decorative={false} class="project-flow"/>
<section class="locations section"><h2 class="eyebrow">{c.locationsLabel}</h2><p class="locations-title">Paris <span>·</span> Val-d’Oise <span>·</span> Goa</p><p>{c.locations}</p><a class="text-link" href={url(lang,'contact')}>{c.locationsCta}</a></section>
<section class="final-cta section"><h2>RECONNECT.</h2><p class="serif">{c.closing}</p><a class="button" href={url(lang,'contact')}>{t.book}</a></section>

</div>

<script is:inline>
const gaiaPhotoOption = new URLSearchParams(window.location.search).get('hero');
if (gaiaPhotoOption === 'organic') document.querySelector('.gaia-home').dataset.heroPhoto = 'organic';
</script>
