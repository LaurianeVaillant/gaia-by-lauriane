---
import Base from '../../layouts/Base.astro';
import Acupuncture from '../../components/Acupuncture.astro';
import WomensHealth from '../../components/WomensHealth.astro';
import About from '../../components/About.astro';
import {routes,labels,descriptions,url,site,type Lang,type Page} from '../../data/site';
export function getStaticPaths(){return (['fr','en'] as Lang[]).flatMap(lang=>Object.entries(routes).filter(([key])=>key!=='home').map(([key,values])=>({params:{lang,slug:values[lang]},props:{page:key}})));}
const lang=Astro.params.lang as Lang;const {page}=Astro.props as {page:Page};const fr=lang==='fr';const t=labels[lang];
const intros={acupuncture:fr?'Comprendre, relier, réorienter.':'Understand, connect, redirect.',aculift:fr?'Le visage fait partie du tout.':'The face is part of the whole.',pranic:fr?'Une autre façon d’écouter les liens.':'Another way to listen to connection.',women:fr?'Vivre sa féminité, pas la subir.':'Your body. Your rhythm. Your experience.',about:'I was looking for a way to connect the dots.',journal:fr?'Des idées qui se relient.':'Ideas that connect.',contact:fr?'Commençons par une rencontre.':'Let’s begin with a conversation.',links:fr?'Se reconnecter à ce qui a toujours été là.':'Reconnect with what has always been there.',home:''};
---
<Base lang={lang} page={page} title={fr&&page==='acupuncture'?'Acupuncture traditionnelle — Lauriane | GAIA':fr&&page==='women'?'Santé féminine — Cycles & approche de Lauriane | GAIA':fr&&page==='about'?'À propos de Lauriane — Parcours & formations | GAIA':undefined}>{fr&&page==='acupuncture'?<Acupuncture/>:fr&&page==='women'?<WomensHealth/>:fr&&page==='about'?<About/>:<section class:list={['section','inner',{'link-hub':page==='links'}]}><p class="eyebrow">GAIA by Lauriane / {t[page]}</p><h1>{page==='links'?'Gaia':page==='contact'?intros.contact:t[page]}</h1><p class="lead">{page==='contact'?descriptions[lang].contact:intros[page]}</p>{page==='links'?<div class="link-list">{(['contact','acupuncture','women','about','journal'] as Page[]).map(p=><a class="button" href={url(lang,p)}>{p==='contact'?t.book:t[p]}</a>)}</div>:page==='journal'?<div class="journal-empty"><div class="categories"><span>Acupuncture</span><span>{t.women}</span><span>Body & Energy</span><span>Reconnection</span></div><h2 class="medium" style="margin:2rem 0 1rem">{fr?'Le Journal prend forme.':'The Journal is taking shape.'}</h2><p>{fr?'Les premiers articles seront publiés ici. Revenez bientôt pour explorer les liens entre corps, énergie et quotidien.':'The first articles will appear here. Come back soon to explore connections between the body, energy and everyday life.'}</p></div>:page==='contact'?<div class="status"><h2 class="medium">{fr?'Informations à venir':'Details coming soon'}</h2><p style="margin-top:1.5rem">{fr?'Les coordonnées, le lien de réservation et les périodes de consultation ne sont pas encore confirmés pour le site. Ils seront ajoutés ici avant son ouverture au public.':'Contact details, the booking link and practice dates have not yet been confirmed for the website. They will be added here before the public launch.'}</p><p>{fr?'Paris · Val-d’Oise · Goa : les lieux seront précisés selon les périodes et les collaborations effectives.':'Paris · Val-d’Oise · Goa: locations will be specified according to confirmed dates and collaborations.'}</p></div>:<><p>{descriptions[lang][page]}</p><div class="status"><p>{fr?'Cette page sera développée avec Lauriane lors de la prochaine étape. Retrouvez dès maintenant les grandes lignes de l’approche sur la page d’accueil.':'This page will be developed with Lauriane in the next stage. You can already explore the approach on the homepage.'}</p><a class="text-link" href={url(lang)}>{fr?'Explorer GAIA':'Explore GAIA'}</a></div><a class="button" style="margin-top:2rem" href={url(lang,'contact')}>{t.book}</a></>}</section>}</Base>
