---
import Base from '../../layouts/Base.astro';
import {englishBookingLink as bookingLink} from '../../data/booking';
import '../../styles/booking-system.css';
const practices = [['Traditional Acupuncture','acupuncture'],['Aculift','aculift'],['Pranic Healing','pranic-healing'],['Women’s Health','womens-health']];
---
<Base lang="en" page="contact" title="Book an appointment — GAIA by Lauriane" booking>
<div class="booking-page">
<section class="bk-hero" aria-labelledby="booking-title">
<p class="bk-label">BOOK AN APPOINTMENT</p>
<h1 id="booking-title">Book an<br class="bk-desktop-break"/> appointment<span>.</span></h1>
<div class="bk-intro"><p>For now, appointments are arranged directly with me on WhatsApp.</p><p>Locations and availability may vary over time — I’ll confirm everything with you directly.</p></div>
<a class="button bk-whatsapp" href={bookingLink}>Message me on WhatsApp <span aria-hidden="true">↗</span></a>
<p class="bk-cities">Paris · Val-d’Oise · Goa — depending on when I’m there.</p>
</section>
<section class="bk-practices bk-section" aria-labelledby="practice-title"><div><h2 id="practice-title">Which practice?</h2></div><ul>{practices.map(([title,slug])=><li><a href={`/en/${slug}/`}>{title}<span aria-hidden="true">↗</span></a></li>)}</ul><p class="bk-note">Not sure which approach to choose? Just tell me what brings you here, and we’ll work out together what seems most appropriate.</p></section>
<section class="bk-how bk-section" aria-labelledby="how-title"><h2 id="how-title">How does it work?</h2><ol><li>Message me on WhatsApp.</li><li>Tell me which practice interests you and, if you’d like, a few words about what brings you here.</li><li>I’ll suggest a time and confirm the location.</li></ol></section>
<section class="bk-closing bk-section" aria-labelledby="closing-title"><div><h2 id="closing-title">Shall we talk?</h2><p>Send me a message and we’ll take it from there.</p></div><a class="button bk-whatsapp" href={bookingLink}>Message me on WhatsApp <span aria-hidden="true">↗</span></a></section>
</div>
</Base>
