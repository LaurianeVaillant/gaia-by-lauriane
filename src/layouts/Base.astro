---
import {site,url,bookingUrl,translatedPages,labels,descriptions,type Lang,type Page} from '../data/site';
import '../styles/global.css';
import '../styles/navigation.css';
import '../styles/responsive-audit-fixes.css';
import '../styles/footer-system.css';
import '@fontsource-variable/fraunces';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
interface Props {lang:Lang;page?:Page;title?:string;booking?:boolean;}
const {lang,page='home',title,booking=false} = Astro.props; const t=labels[lang]; const other=lang==='fr'?'en':'fr';
const pageTitle=title || (page==='home'?(lang==='fr'?'GAIA by Lauriane | Acupuncture traditionnelle, Aculift & Pranic Healing':'GAIA by Lauriane | Traditional Acupuncture, Aculift & Pranic Healing'):t[page]+' — GAIA by Lauriane');
const gaiaSystem=booking||page==='home'||((page==='acupuncture'||page==='aculift'||page==='pranic'||page==='women'||page==='about'));
const practicePages:Page[]=['acupuncture','aculift','pranic'];
const practiceActive=practicePages.includes(page);
const practiceName=lang==='fr'?'Pratiques':'Practices';
const practiceLabel=(p:Page)=>p==='acupuncture'?(lang==='fr'?'Acupuncture traditionnelle':'Traditional Acupuncture'):t[p];
const equivalent=(l:Lang)=>booking?bookingUrl(l):url(l,page);
const hasEquivalent=booking||translatedPages.includes(page);
const pageDescription=booking?(lang==='fr'?descriptions.fr.contact:'Arrange an appointment with Lauriane on WhatsApp. Explore the practices, how booking works, and consultation locations in Paris, Val-d’Oise and Goa.'):descriptions[lang][page];
const canonical=new URL(booking?bookingUrl(lang):url(lang,page),site.origin).href;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>{gaiaSystem&&<><link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="/fonts/InstrumentSans-Latin-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/></>}<title>{pageTitle}</title><meta name="description" content={pageDescription}/><link rel="canonical" href={canonical}/>{hasEquivalent&&<>{(['fr','en'] as const).map(l=><link rel="alternate" hreflang={l} href={new URL(equivalent(l),site.origin).href}/>)}<link rel="alternate" hreflang="x-default" href={new URL(equivalent('fr'),site.origin).href}/></>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#FFF6CC"/><meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={pageDescription}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang==='fr'?'fr_FR':'en_GB'}/><meta property="og:image" content={site.origin+'/images/portrait-1200.webp'}/><meta property="og:image:alt" content={lang==='fr'?'Lauriane au bord de la mer au coucher du soleil':'Lauriane by the sea at sunset'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={pageDescription}/><meta name="twitter:image" content={site.origin+'/images/portrait-1200.webp'}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':[{'@type':'Person','@id':site.origin+'/#lauriane',name:'Lauriane',jobTitle:lang==='fr'?'Praticienne en acupuncture traditionnelle':'Traditional Acupuncture Practitioner',url:site.origin+url('fr','about')},...(page==='home'?[{'@type':'WebSite','@id':site.origin+'/#website',name:site.name,url:site.origin+'/',inLanguage:['fr','en'],publisher:{'@id':site.origin+'/#lauriane'}}]:[])]})}/></head><body class:list={[{'gaia-home-shell':page==='home','gaia-internal-shell':booking||(page==='acupuncture'||page==='aculift'||page==='pranic'||page==='women'||page==='about')}]}><a class="skip" href="#main">{lang==='fr'?'Aller au contenu':'Skip to content'}</a><header class="header"><a class="mini-logo" href={url(lang)} aria-label={lang==='fr'?'GAIA by Lauriane — Accueil':'GAIA by Lauriane — Home'}>Gaia<span>by Lauriane</span></a><nav class="desktop-nav" aria-label={lang==='fr'?'Navigation principale':'Main navigation'}><details class="practice-menu" data-nav-disclosure><summary class:list={{'nav-active':practiceActive}}>{practiceName}<span class="nav-chevron" aria-hidden="true"></span></summary><div class="practice-dropdown">{practicePages.map(p=><a href={url(lang,p)} aria-current={page===p?'page':undefined}>{practiceLabel(p)}</a>)}</div></details>{(['women','about'] as Page[]).map(p=><a href={url(lang,p)} aria-current={page===p?'page':undefined}>{t[p]}</a>)}</nav><div class="header-actions"><a class="language" href={equivalent(other)} lang={other} aria-label={other==='en'?'View this page in English':'Voir cette page en français'}><span class={lang==='fr'?'active':''}>FR</span><span>/</span><span class={lang==='en'?'active':''}>EN</span></a><a class="button small" href={bookingUrl(lang)}>{t.book}</a><details class="mobile-nav" data-nav-disclosure><summary aria-controls="mobile-menu">{t.menu} <span aria-hidden="true">☰</span></summary><nav id="mobile-menu" aria-label={lang==='fr'?'Navigation mobile':'Mobile navigation'}><details class="mobile-practices" data-nav-disclosure><summary class:list={{'nav-active':practiceActive}}>{practiceName}<span class="nav-chevron" aria-hidden="true"></span></summary><div class="mobile-practice-links">{practicePages.map(p=><a href={url(lang,p)} aria-current={page===p?'page':undefined}>{practiceLabel(p)}</a>)}</div></details>{(['women','about'] as Page[]).map(p=><a href={url(lang,p)} aria-current={page===p?'page':undefined}>{t[p]}</a>)}<a class="language mobile-language" href={equivalent(other)} lang={other} aria-label={other==='en'?'View this page in English':'Voir cette page en français'}><span class={lang==='fr'?'active':''}>FR</span><span>/</span><span class={lang==='en'?'active':''}>EN</span></a><a class="button mobile-booking" href={bookingUrl(lang)}>{t.book}</a></nav></details></div></header><main id="main"><slot/></main><footer class="site-footer"><div class="footer-brand">Gaia<span>by Lauriane</span></div><div><a href={bookingUrl(lang)}>{t.contact}</a> · <a href={'/links/'}>{t.links}</a></div><p class="legal">© {new Date().getFullYear()} GAIA by Lauriane<br/>{lang==='fr'?'Pratiques complémentaires, sans substitution au suivi médical.':'Complementary practices, not a substitute for medical care.'}</p></footer></body></html>

<script>
 document.addEventListener('keydown', (event) => {
  if(event.key!=='Escape') return;
  const open=[...document.querySelectorAll<HTMLDetailsElement>('[data-nav-disclosure][open]')];
  const focused=document.activeElement;
  const target=open.reverse().find(menu=>focused instanceof Node && menu.contains(focused))||open[0];
  if(target){target.open=false;target.querySelector<HTMLElement>(':scope > summary')?.focus();event.preventDefault();}
 });
 document.addEventListener('click', (event) => {
  if(!(event.target instanceof Node)) return;
  document.querySelectorAll<HTMLDetailsElement>('.practice-menu[open],.mobile-nav[open]').forEach(menu=>{if(!menu.contains(event.target as Node)) menu.open=false;});
 });
</script>
