---
import {site,url,labels,descriptions,type Lang,type Page} from '../data/site';
import '../styles/global.css';
import internalSansFonts from '@fontsource-variable/dm-sans/index.css?inline';
import '@fontsource-variable/fraunces';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import internalSerifFonts from '@fontsource/cormorant-garamond/500.css?inline';
interface Props {lang:Lang;page?:Page;title?:string;}
const {lang,page='home',title} = Astro.props; const t=labels[lang]; const other=lang==='fr'?'en':'fr';
const pageTitle=title || (page==='home'?(lang==='fr'?'GAIA by Lauriane | Acupuncture traditionnelle, Aculift & Pranic Healing':'GAIA by Lauriane — Traditional acupuncture & reconnection'):t[page]+' — GAIA by Lauriane');
const canonical=new URL(url(lang,page),site.origin).href;
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"/>{page!=='home'&&<style is:inline set:html={internalSansFonts+internalSerifFonts}/>}<meta name="viewport" content="width=device-width,initial-scale=1"/>{page==='home'&&<><link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin="anonymous"/><link rel="preload" href="/fonts/InstrumentSans-Latin-Variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/></>}<title>{pageTitle}</title><meta name="description" content={descriptions[lang][page]}/><link rel="canonical" href={canonical}/>{(['fr','en'] as const).map(l=><link rel="alternate" hreflang={l} href={new URL(url(l,page),site.origin).href}/>)}<link rel="alternate" hreflang="x-default" href={new URL(url('fr',page),site.origin).href}/><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><meta name="theme-color" content="#FFF6CC"/><meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={descriptions[lang][page]}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={lang==='fr'?'fr_FR':'en_GB'}/><meta property="og:image" content={site.origin+'/images/portrait-1200.webp'}/><meta property="og:image:alt" content={lang==='fr'?'Lauriane au bord de la mer au coucher du soleil':'Lauriane by the sea at sunset'}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={descriptions[lang][page]}/><meta name="twitter:image" content={site.origin+'/images/portrait-1200.webp'}/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Person',name:'Lauriane',jobTitle:lang==='fr'?'Praticienne en acupuncture traditionnelle':'Traditional Acupuncture Practitioner',url:site.origin+url(lang,'about')})}/></head><body class:list={[{'gaia-home-shell':page==='home'}]}><a class="skip" href="#main">{lang==='fr'?'Aller au contenu':'Skip to content'}</a><header class="header"><a class="mini-logo" href={url(lang)} aria-label={lang==='fr'?'GAIA by Lauriane — Accueil':'GAIA by Lauriane — Home'}>Gaia<span>by Lauriane</span></a><nav class="desktop-nav" aria-label={lang==='fr'?'Navigation principale':'Main navigation'}>{(['acupuncture','about','journal'] as Page[]).map(p=><a href={url(lang,p)} aria-current={page===p?'page':undefined}>{t[p]}</a>)}</nav><div class="header-actions"><a class="language" href={url(other,page)} lang={other} aria-label={other==='en'?'View this page in English':'Voir cette page en français'}><span class={lang==='fr'?'active':''}>FR</span><span>/</span><span class={lang==='en'?'active':''}>EN</span></a><a class="button small" href={url(lang,'contact')}>{t.book}</a><details class="mobile-nav"><summary aria-controls="mobile-menu">{t.menu} <span aria-hidden="true">☰</span></summary><nav id="mobile-menu" aria-label={lang==='fr'?'Navigation mobile':'Mobile navigation'}>{(['home','acupuncture','aculift','pranic','women','about','journal','contact'] as Page[]).map(p=><a href={url(lang,p)}>{t[p]}</a>)}</nav></details></div></header><main id="main"><slot/></main><footer><div class="footer-brand">Gaia<span>by Lauriane</span></div><div><a href={url(lang,'contact')}>{t.contact}</a> · <a href={url(lang,'links')}>{t.links}</a></div><p class="legal">© {new Date().getFullYear()} GAIA by Lauriane<br/>{lang==='fr'?'Pratiques complémentaires, sans substitution au suivi médical.':'Complementary practices, alongside medical care.'}</p></footer></body></html>
